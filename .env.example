# ==============================================================================
# MAXZONE ISP-ERP — Master Environment Variables Configuration Template
# ==============================================================================
# Security Policy:
# - NEVER commit real credentials or production keys to version control.
# - Copy this file to '.env' and populate with production values.
# ==============================================================================

# --- Global Application Configuration ---
APP_NAME=Maxzone
APP_ENV=production                     # 'development', 'staging', 'production'
APP_PORT=8080                          # Backend HTTP API port
APP_URL=https://isp.yourdomain.com
FRONTEND_URL=https://isp.yourdomain.com
DOMAIN=isp.yourdomain.com

# --- Cryptographic Keys ---
# 32-byte Base64-encoded key used for AES-256-GCM database field encryption
APP_KEY=base64:QUJDREVGR0hJSktMTU5PUFFSU1RVVldYWVowMTIzNDU=

# JWT Secrets for Authentication
JWT_SECRET=CHANGE_THIS_TO_A_64_CHARACTER_RANDOM_STRING_FOR_JWT_SECURITY
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# --- PostgreSQL & PostGIS Database ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=maxzone_user
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
DB_NAME=maxzone_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# --- Redis Cache & Asynq Task Queue ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE
REDIS_DB=0

# --- FreeRADIUS 3.x AAA Engine ---
RADIUS_SERVER_IP=127.0.0.1
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799
RADIUS_SECRET=testing123-radius-secret

# --- Default Super Admin Seed Credentials ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@maxzone.local
INITIAL_ADMIN_PHONE=01700000000
INITIAL_ADMIN_PASSWORD=Maxzone@2026

# --- South Asian / Bangladesh Payment Gateways ---
# bKash Tokenized Checkout
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_merchant_username
BKASH_PASSWORD=your_bkash_merchant_password
BKASH_IS_SANDBOX=true

# Nagad Merchant API
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_PRIVATE_KEY=your_nagad_private_key
NAGAD_IS_SANDBOX=true

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=true

# --- SMS Gateway Adapters ---
SMS_PROVIDER=greenweb                  # 'greenweb', 'bulksmsbd', 'alphasms', 'generic'
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=MAXZONE
