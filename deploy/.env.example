# ==============================================================================
# Maxzone — production configuration
# Copy to .env and fill in real values BEFORE running:  ./maxzone.sh up
#   cp .env.example .env  &&  nano .env
# ==============================================================================

# Public site address. For automatic HTTPS use a real domain:
#   SITE_ADDRESS=maxzone.example.com
# For plain HTTP (development / behind another TLS terminator):
#   SITE_ADDRESS=http://127.0.0.1
SITE_ADDRESS=http://127.0.0.1

# Browser-facing base URLs (default: https://${SITE_ADDRESS}).
# Override when SITE_ADDRESS is not the browser origin (e.g. plain-HTTP validation).
APP_URL=http://127.0.0.1
FRONTEND_URL=http://127.0.0.1

# --- PostgreSQL ---
DB_USER=maxzone_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=maxzone_db

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- JWT (generate with: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_RANDOM_HEX_64

# --- Initial super admin (seeded automatically on first boot) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- Caddy ACME contact + optional monthly invoice worker ---
ACME_EMAIL=admin@maxzone.local
WORKER_ENABLE_INVOICES=false