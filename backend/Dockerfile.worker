# ==============================================================================
# Production multi-stage build for the Maxzone background worker
# ==============================================================================

# ---- Build stage ----
FROM golang:1.25 AS builder
WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/maxzone-worker ./cmd/worker

# ---- Runtime stage ----
FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
ENV TZ=Asia/Dhaka

WORKDIR /app
COPY --from=builder /out/maxzone-worker /app/maxzone-worker

ENTRYPOINT ["/app/maxzone-worker"]